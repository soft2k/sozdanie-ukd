// Добавляется только к тестовой копии EPF. В поставляемой обработке этого кода нет.
&НаКлиенте
Процедура ТестПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьТест", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьТест() Экспорт
	Попытка
		ВыполнитьТестНаСервере();
	Исключение
		Отчет = Новый ТекстовыйДокумент;
		Отчет.УстановитьТекст("FAIL CLIENT" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Отчет.Записать("@@REPORT@@", КодировкаТекста.UTF8);
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	Отчет = Новый ТекстовыйДокумент;
	Отчет.ДобавитьСтроку("START " + Строка(ТекущаяДатаСеанса()));
	Попытка
		ОрганизацияТеста = Справочники.Организации.ПустаяСсылка();
		Выборка = Справочники.Организации.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления Или Выборка.Ссылка = Справочники.Организации.УправленческаяОрганизация Тогда
				Продолжить;
			КонецЕсли;
			ПараметрыУчетаНДСОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Выборка.Ссылка, ТекущаяДатаСеанса());
			Если ЗначениеЗаполнено(ПараметрыУчетаНДСОрганизации.ОсновноеНалогообложениеНДСПродажи) Тогда
				ОрганизацияТеста = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ПроверитьУсловиеТеста(ЗначениеЗаполнено(ОрганизацияТеста), "Не найдена обычная организация с настроенным налогообложением продаж");
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Контрагенты.Ссылка КАК Ссылка
			|ИЗ Справочник.Контрагенты КАК Контрагенты
			|ГДЕ НЕ Контрагенты.ПометкаУдаления
			| И Контрагенты.Партнер.Клиент И НЕ Контрагенты.Партнер.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО Контрагенты.Ссылка");
		Выборка = Запрос.Выполнить().Выбрать();
		ПроверитьУсловиеТеста(Выборка.Следующий(), "Не найден контрагент-клиент для теста");
		КонтрагентТеста = Выборка.Ссылка;
		Отчет.ДобавитьСтроку("Организация: " + Строка(ОрганизацияТеста));
		Отчет.ДобавитьСтроку("Контрагент: " + Строка(КонтрагентТеста));
		Обработка = РеквизитФормыВЗначение("Объект");
		ПроверитьРегистрациюФоновогоРежима(Обработка);
		ПараметрыТеста = Новый Структура("Организация,Контрагент,Количество,НомерЦепочки,ИдентификаторЗапуска",
			ОрганизацияТеста, КонтрагентТеста, 11, 1, Новый УникальныйИдентификатор("@@RUN_ID@@"));
		КонтрольДоТеста = Константы.КонтролироватьОстаткиТоваровОрганизаций.Получить();
		Для Номер = 1 По 10 Цикл
			ПараметрыТеста.НомерЦепочки = Номер;
			Результат = Обработка.СоздатьЦепочку(ПараметрыТеста);
			Для Каждого Пара Из Результат Цикл
				ПроверитьУсловиеТеста(Пара.Значение.Проведен, "Не проведен " + Пара.Ключ);
			КонецЦикла;
			Продажа = Результат.Реализация.ПолучитьОбъект();
			Корректировка = Результат.Корректировка.ПолучитьОбъект();
			Если ЗначениеЗаполнено(Продажа.Соглашение) Тогда
				ОжидаемыйНомерСоглашения = "УКД" + Лев(СтрЗаменить(
					Строка(ПараметрыТеста.ИдентификаторЗапуска), "-", ""), 8);
				ФактическийНомерСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					Продажа.Соглашение, "Номер");
				ПроверитьУсловиеТеста(ФактическийНомерСоглашения = ОжидаемыйНомерСоглашения,
					"Не заполнен номер соглашения реализации");
			КонецЕсли;
			Если Номер = 1 Тогда
				ПроверитьОбработкуПредупрежденийТеста(Результат, Продажа);
			КонецЕсли;
			ПроверитьУсловиеТеста(Продажа.Товары.Количество() = 1 И Корректировка.Товары.Количество() = 1, "Число строк товаров");
			ПроверитьУсловиеТеста(Продажа.Товары[0].Количество = Номер, "Количество в реализации");
			ПроверитьУсловиеТеста(Корректировка.Товары[0].Количество = ?(Номер < 10, Номер + 1, 9), "Изменение количества");
			ПроверитьУсловиеТеста(Корректировка.Расхождения.Количество() = 1, "Число строк расхождений");
			Расхождение = Корректировка.Расхождения[0];
			ПроверитьУсловиеТеста(Расхождение.Количество = ?(Номер < 10, 1, -1), "Знак и величина расхождения");
			ОрдерныеРасхождения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Продажа.Склад, "ИспользоватьОрдернуюСхемуПриОтраженииИзлишковНедостач");
			Если Номер < 10 Тогда
				ОжидаемоеОтражение = ?(ОрдерныеРасхождения,
					Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУчестьПриИнвентаризации,
					Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУменьшитьСкладскиеОстатки);
			Иначе
				ОжидаемоеОтражение = ?(ОрдерныеРасхождения,
					Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУчестьПриИнвентаризации,
					Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУвеличитьСкладскиеОстатки);
			КонецЕсли;
			ПроверитьУсловиеТеста(Расхождение.ВариантОтражения = ОжидаемоеОтражение, "Вариант отражения расхождения");
			ПроверитьУсловиеТеста(Продажа.НалогообложениеНДС
				= ПараметрыУчетаНДСОрганизации.ОсновноеНалогообложениеНДСПродажи, "Налогообложение организации");
			ПроверитьУсловиеТеста(УчетНДСУП.СтавкаНДСКорректна(Продажа.Товары[0].СтавкаНДС,
				Продажа.НалогообложениеНДС, ОрганизацияТеста, Продажа.Дата), "НДС реализации");
			ПроверитьУсловиеТеста(Корректировка.Товары[0].СтавкаНДС = Продажа.Товары[0].СтавкаНДС, "НДС корректировки");
			ПроверитьУсловиеТеста(Корректировка.НалогообложениеНДС = Продажа.НалогообложениеНДС, "Налогообложение корректировки");
			Если Продажа.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС Тогда
				ПроверитьУсловиеТеста(Продажа.Товары[0].СтавкаНДС = Справочники.СтавкиНДС.БезНДС, "Ставка без НДС");
				ПроверитьУсловиеТеста(Продажа.Товары[0].СуммаНДС = 0 И Корректировка.Товары[0].СуммаНДС = 0, "Сумма без НДС");
			КонецЕсли;
			ПроверитьУсловиеТеста(Корректировка.ДокументОснование = Результат.Реализация, "Основание корректировки");
			ПроверитьУсловиеТеста(Результат.СчетФактура.ДокументОснование = Результат.Корректировка, "Основание счета-фактуры");
			ИсходныйСФ = Результат.ИсходныйСчетФактура.ПолучитьОбъект();
			КорректировочныйСФ = Результат.СчетФактура.ПолучитьОбъект();
			ПроверитьУсловиеТеста(Не ИсходныйСФ.Корректировочный И Не ИсходныйСФ.Исправление, "Вид исходного счета-фактуры");
			ПроверитьУсловиеТеста(ИсходныйСФ.ДокументОснование = Результат.Реализация, "Основание исходного счета-фактуры");
			ПроверитьУсловиеТеста(ИсходныйСФ.ДокументыОснования.Количество() = 1, "Число оснований исходного счета-фактуры");
			ПроверитьУсловиеТеста(ИсходныйСФ.ДокументыОснования[0].ДокументОснование = Результат.Реализация, "Таблица оснований исходного счета-фактуры");
			// У обычного исходного СФ таблица товаров может быть пустой — это не ошибка.
			ПроверитьУсловиеТеста(КорректировочныйСФ.Корректировочный И Не КорректировочныйСФ.Исправление, "Вид корректировочного счета-фактуры");
			ПроверитьУсловиеТеста(КорректировочныйСФ.Товары.Количество() > 0, "Товары корректировочного счета-фактуры");
			Для Каждого СтрокаСФ Из КорректировочныйСФ.Товары Цикл
				ПроверитьУсловиеТеста(СтрокаСФ.ПредыдущийСчетФактура = Результат.ИсходныйСчетФактура, "Связь с исходным счетом-фактурой");
			КонецЦикла;
			Повтор = Обработка.СоздатьЦепочку(ПараметрыТеста);
			Для Каждого Пара Из Результат Цикл
				ПроверитьУсловиеТеста(Повтор[Пара.Ключ] = Пара.Значение, "Повтор создал дубль " + Пара.Ключ);
			КонецЦикла;
			ПроверитьУсловиеТеста(Константы.КонтролироватьОстаткиТоваровОрганизаций.Получить() = КонтрольДоТеста,
				"Изменилось состояние контроля остатков");
			Отчет.ДобавитьСтроку("PASS chain " + Строка(Номер) + ": " + Строка(Результат.Корректировка));
			Отчет.Записать("@@REPORT@@", КодировкаТекста.UTF8);
		КонецЦикла;
		РезультатыЗапуска = Обработка.ПолучитьРезультатыЗапуска(ПараметрыТеста.ИдентификаторЗапуска);
		ПроверитьУсловиеТеста(РезультатыЗапуска.Количество() = 10, "Не восстановлены результаты серии");
		Для Индекс = 0 По 9 Цикл
			СтрокаРезультата = РезультатыЗапуска[Индекс];
			ПроверитьУсловиеТеста(СтрокаРезультата.НомерЦепочки = Индекс + 1,
				"Нарушен порядок восстановленных результатов");
			ПроверитьУсловиеТеста(ЗначениеЗаполнено(СтрокаРезультата.Реализация)
				И ЗначениеЗаполнено(СтрокаРезультата.ИсходныйСчетФактура)
				И ЗначениеЗаполнено(СтрокаРезультата.Корректировка)
				И ЗначениеЗаполнено(СтрокаРезультата.СчетФактура),
				"В восстановленной цепочке не хватает документов");
		КонецЦикла;
		// В тестовой копии внедрен отказ перед последним счетом-фактурой цепочки 11.
		ПараметрыТеста.НомерЦепочки = 11;
		ПолученОжидаемыйОтказ = Ложь;
		Попытка
			Обработка.СоздатьЦепочку(ПараметрыТеста);
		Исключение
			ПолученОжидаемыйОтказ = СтрНайти(ОписаниеОшибки(), "UKD_TEST_ROLLBACK") > 0;
		КонецПопытки;
		ПроверитьУсловиеТеста(ПолученОжидаемыйОтказ, "Не сработал внедренный отказ");
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ссылка ИЗ Документ.РеализацияТоваровУслуг ГДЕ Комментарий ПОДОБНО &Маркер
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ Ссылка ИЗ Документ.КорректировкаРеализации ГДЕ Комментарий ПОДОБНО &Маркер
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ Ссылка ИЗ Документ.СчетФактураВыданный ГДЕ Комментарий ПОДОБНО &Маркер");
		Запрос.УстановитьПараметр("Маркер", "УКД-ТЕСТ:@@RUN_ID@@:11");
		ПроверитьУсловиеТеста(Запрос.Выполнить().Пустой(), "После отката остались документы");
		ПроверитьУсловиеТеста(Константы.КонтролироватьОстаткиТоваровОрганизаций.Получить() = КонтрольДоТеста,
			"После отката изменился контроль остатков");
		ПроверитьУсловиеТеста(Не ТранзакцияАктивна(), "Осталась открытая транзакция");
		Отчет.ДобавитьСтроку("PASS rollback");
		Отчет.ДобавитьСтроку("PASS ALL");
	Исключение
		Отчет.ДобавитьСтроку("FAIL" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Отчет.Записать("@@REPORT@@", КодировкаТекста.UTF8);
КонецПроцедуры

&НаСервере
Процедура ПроверитьРегистрациюФоновогоРежима(Обработка)

	Сведения = Обработка.СведенияОВнешнейОбработке();
	ПроверитьУсловиеТеста(Сведения.БезопасныйРежим = Ложь,
		"Безопасный режим не отключен для создания экземпляра обработки в фоне");
	КомандаОткрытия = Сведения.Команды.Найти("ОткрытьФорму", "Идентификатор");
	ПроверитьУсловиеТеста(КомандаОткрытия <> Неопределено
		И КомандаОткрытия.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы(),
		"Не зарегистрирована команда открытия формы");
	КомандаФона = Сведения.Команды.Найти(Обработка.ИдентификаторФоновойКоманды(), "Идентификатор");
	ПроверитьУсловиеТеста(КомандаФона <> Неопределено
		И КомандаФона.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода()
		И КомандаФона.Скрыть,
		"Не зарегистрирована скрытая серверная команда фонового задания");

КонецПроцедуры

&НаСервере
Процедура ПроверитьОбработкуПредупрежденийТеста(Результат, Продажа)

	// Два одинаковых предупреждения с разными основаниями: убрать можно только
	// предупреждение реализации. Сообщение другого документа должно сохраниться.
	ТекстНехватки = СтрШаблон("По организации %1 на складе %2 не хватает 2 %3 товара %4",
		Продажа.Организация, Продажа.Склад, Продажа.Товары[0].Номенклатура.ЕдиницаИзмерения,
		Продажа.Товары[0].Номенклатура);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстНехватки;
	Сообщение.КлючДанных = Результат.Реализация;
	Сообщение.Сообщить();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстНехватки;
	Сообщение.КлючДанных = Результат.ИсходныйСчетФактура;
	Сообщение.Сообщить();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "UKD_TEST_OTHER_WARNING";
	Сообщение.КлючДанных = Результат.Реализация;
	Сообщение.Поле = "Товары[0].Количество";
	Сообщение.Сообщить();

	ПеренестиПредупрежденияОбОстаткахВЖурнал(Результат);
	СохраненоЧужоеПредупреждение = Ложь;
	СохраненоДругоеПредупреждение = Ложь;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		ПроверитьУсловиеТеста(Сообщение.Текст <> ТекстНехватки
			Или Сообщение.КлючДанных <> Результат.Реализация, "Осталось предупреждение тестовой реализации");
		Если Сообщение.Текст = ТекстНехватки И Сообщение.КлючДанных = Результат.ИсходныйСчетФактура Тогда
			СохраненоЧужоеПредупреждение = Истина;
		КонецЕсли;
		Если Сообщение.Текст = "UKD_TEST_OTHER_WARNING" Тогда
			СохраненоДругоеПредупреждение = Сообщение.КлючДанных = Результат.Реализация
				И Сообщение.Поле = "Товары[0].Количество";
		КонецЕсли;
	КонецЦикла;
	ПроверитьУсловиеТеста(СохраненоЧужоеПредупреждение, "Потеряно предупреждение другого документа");
	ПроверитьУсловиеТеста(СохраненоДругоеПредупреждение, "Потеряны сообщение или привязка к полю");

КонецПроцедуры

&НаСервере
Процедура ПроверитьУсловиеТеста(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание для регистрации в подсистеме БСП
// "Дополнительные отчеты и обработки". Именно эта подсистема
// загружает EPF в отдельном фоновом сеансе.
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.6.100");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "2.0.0.0";
	// Фоновый сеанс должен создать экземпляр внешней обработки.
	// Права пользователя и все бизнес-проверки при этом сохраняются.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Создать тестовые корректировки'");
	Команда.Идентификатор = ИдентификаторКомандыОткрытияФормы();
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	// Скрытая команда — точка входа для отдельного фонового сеанса.
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Фоновое создание документов'");
	Команда.Идентификатор = ИдентификаторФоновойКоманды();
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Ложь;
	Команда.Скрыть = Истина;

	Возврат ПараметрыРегистрации;

КонецФункции

Функция ИдентификаторФоновойКоманды() Экспорт

	Возврат "СоздатьДокументыВФоне";

КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды <> ИдентификаторФоновойКоманды() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестная команда внешней обработки: %1.'"),
			ИдентификаторКоманды);
	КонецЕсли;
	ВыполнитьФоновоеСоздание(ПараметрыВыполнения);

КонецПроцедуры

// Создает одну атомарную цепочку тестовых документов. Повтор с тем же ключом
// возвращает уже созданную цепочку. Вызывать вне транзакции.
//
// Параметры:
//  Параметры - Структура:
//   * Организация - СправочникСсылка.Организации
//   * Контрагент - СправочникСсылка.Контрагенты
//   * ИдентификаторЗапуска - УникальныйИдентификатор
//   * НомерЦепочки - Число
//   * Количество - Число - требуемое количество корректировок.
//
// Возвращаемое значение:
//  Структура - ссылки на реализацию, исходный счет-фактуру, корректировку
//             и корректировочный счет-фактуру.
//
Функция СоздатьЦепочку(Знач Параметры) Экспорт

	ПроверитьПараметры(Параметры);
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Создание цепочки необходимо вызывать вне транзакции.'");
	КонецЕсли;
	Маркер = "УКД-ТЕСТ:" + Строка(Параметры.ИдентификаторЗапуска)
		+ ":" + Формат(Параметры.НомерЦепочки, "ЧГ=0");

	НачатьТранзакцию();
	Попытка
		// Единый порядок: константа, выбранные стороны, затем тестовые справочники.
		// Константа также сериализует повторную отправку одного запроса.
		ЗаблокироватьНастройкуКонтроля();
		Результат = НайтиСозданнуюЦепочку(Маркер, Параметры);
		Если Результат = Неопределено Тогда
			ЗаблокироватьСтороны(Параметры);
			ДатаДокументов = ТекущаяДатаСеанса();
			Данные = ПодготовитьДанные(Параметры, ДатаДокументов);
			ИсходныйКонтроль = Константы.КонтролироватьОстаткиТоваровОрганизаций.Получить();
			Если ИсходныйКонтроль Тогда
				Константы.КонтролироватьОстаткиТоваровОрганизаций.Установить(Ложь);
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;
			Если ПолучитьФункциональнуюОпцию("КонтролироватьОстаткиТоваровОрганизаций") Тогда
				ВызватьИсключение НСтр("ru = 'Не удалось временно отключить контроль остатков товаров организаций.'");
			КонецЕсли;

			Результат = ЗаписатьЦепочку(Параметры, Данные, ДатаДокументов, Маркер);

			// Другим сеансам не публикуется выключенное состояние константы.
			Если ИсходныйКонтроль Тогда
				Константы.КонтролироватьОстаткиТоваровОрганизаций.Установить(ИсходныйКонтроль);
				ОбновитьПовторноИспользуемыеЗначения();
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		СведенияОбОшибке = ИнформацияОбОшибке();
		ОбновитьПовторноИспользуемыеЗначения();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СозданиеУКД.Ошибка'",
			ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,
			, , Маркер + Символы.ПС + ПодробноеПредставлениеОшибки(СведенияОбОшибке));
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает цепочки, уже созданные фоновым заданием.
// Форма заново читает их из базы, поэтому объемный результат
// не нужно передавать из фонового сеанса в клиентский.
Функция ПолучитьРезультатыЗапуска(Знач ИдентификаторЗапуска) Экспорт

	Если ТипЗнч(ИдентификаторЗапуска) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный идентификатор запуска.'");
	КонецЕсли;
	ПрефиксМаркера = "УКД-ТЕСТ:" + Строка(ИдентификаторЗапуска) + ":";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Реализация.Комментарий КАК Маркер,
		| Реализация.Ссылка КАК Реализация,
		| ИсходныйСФ.Ссылка КАК ИсходныйСчетФактура,
		| Корректировка.Ссылка КАК Корректировка,
		| СчетФактура.Ссылка КАК СчетФактура
		|ИЗ Документ.РеализацияТоваровУслуг КАК Реализация
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Корректировка
		| ПО Корректировка.ДокументОснование = Реализация.Ссылка
		|  И Корректировка.Комментарий ПОДОБНО &ШаблонМаркера
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК ИсходныйСФ
		| ПО ИсходныйСФ.ДокументОснование = Реализация.Ссылка
		|  И ИсходныйСФ.Комментарий ПОДОБНО &ШаблонМаркера
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактура
		| ПО СчетФактура.ДокументОснование = Корректировка.Ссылка
		|  И СчетФактура.Комментарий ПОДОБНО &ШаблонМаркера
		|ГДЕ Реализация.Комментарий ПОДОБНО &ШаблонМаркера";
	Запрос.УстановитьПараметр("ШаблонМаркера", ПрефиксМаркера + "%");
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("НомерЦепочки");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.НомерЦепочки = Число(Сред(СтрокаТаблицы.Маркер,
			СтрДлина(ПрефиксМаркера) + 1));
	КонецЦикла;
	Таблица.Колонки.Удалить(Таблица.Колонки.Маркер);
	Таблица.Сортировать("НомерЦепочки");
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИдентификаторКомандыОткрытияФормы()

	Возврат "ОткрытьФорму";

КонецФункции

Процедура ВыполнитьФоновоеСоздание(ПараметрыВыполнения)

	ПараметрыСоздания = Новый Структура;
	ПараметрыСоздания.Вставить("Организация", ПараметрыВыполнения.Контекст_Организация);
	ПараметрыСоздания.Вставить("Контрагент", ПараметрыВыполнения.Контекст_Контрагент);
	ПараметрыСоздания.Вставить("Количество", ПараметрыВыполнения.Контекст_Количество);
	ПараметрыСоздания.Вставить("НомерЦепочки", ПараметрыВыполнения.Контекст_НомерЦепочки);
	ПараметрыСоздания.Вставить("ИдентификаторЗапуска", Новый УникальныйИдентификатор(
		ПараметрыВыполнения.Контекст_ИдентификаторЗапуска));
	ПроверитьПараметры(ПараметрыСоздания);

	Процент = Окр(100 * (ПараметрыСоздания.НомерЦепочки - 1) / ПараметрыСоздания.Количество, 0);
	ДлительныеОперации.СообщитьПрогресс(Процент,
		СтрШаблон(НСтр("ru = 'Запущено фоновое создание. Завершено: %1 из %2.'"),
			ПараметрыСоздания.НомерЦепочки - 1, ПараметрыСоздания.Количество));

	Для Номер = ПараметрыСоздания.НомерЦепочки По ПараметрыСоздания.Количество Цикл
		ПараметрыСоздания.НомерЦепочки = Номер;
		Результат = СоздатьЦепочку(ПараметрыСоздания);
		ПеренестиПредупрежденияОбОстаткахВЖурнал(Результат);
		Процент = Окр(100 * Номер / ПараметрыСоздания.Количество, 0);
		ДлительныеОперации.СообщитьПрогресс(Процент,
			СтрШаблон(НСтр("ru = 'Фоново завершено: %1 из %2.'"), Номер, ПараметрыСоздания.Количество));
	КонецЦикла;

КонецПроцедуры

Процедура ПеренестиПредупрежденияОбОстаткахВЖурнал(Знач Результат) Экспорт

	Сообщения = ПолучитьСообщенияПользователю(Ложь);
	Если Сообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// До завершения классификации и записи в журнал очередь сообщений не очищаем.
	Попытка
		Продажа = Результат.Реализация.ПолучитьОбъект();
		Если Продажа = Неопределено Или Продажа.Товары.Количество() <> 1 Тогда
			Возврат;
		КонецЕсли;
		НачалоПредупреждения = СтрШаблон(НСтр("ru = 'По организации %1 на складе %2 не хватает '"),
			Продажа.Организация, Продажа.Склад);
		КонецПредупреждения = СтрШаблон(НСтр("ru = ' товара %1'"), Продажа.Товары[0].Номенклатура);
		СообщенияДляПоказа = Новый Массив;
		ЕстьПредупреждения = Ложь;
		Для Каждого Сообщение Из Сообщения Цикл
			ЭтоДокументЦепочки = Сообщение.КлючДанных = Результат.Реализация
				Или Сообщение.КлючДанных = Результат.Корректировка;
			Если ЭтоДокументЦепочки
				И Лев(Сообщение.Текст, СтрДлина(НачалоПредупреждения)) = НачалоПредупреждения
				И Прав(Сообщение.Текст, СтрДлина(КонецПредупреждения)) = КонецПредупреждения Тогда
				ЗаписьЖурналаРегистрации(НСтр("ru = 'СозданиеУКД.ТестовыеОстатки'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация,
					, Сообщение.КлючДанных, Сообщение.Текст);
				ЕстьПредупреждения = Истина;
			Иначе
				СообщенияДляПоказа.Добавить(Сообщение);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Цепочка уже записана: ошибка обработки уведомлений не отменяет результат.
		Возврат;
	КонецПопытки;
	Если ЕстьПредупреждения Тогда
		ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из СообщенияДляПоказа Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#Область ПроверкиИБлокировки

Процедура ПроверитьПараметры(Параметры)

	Если Не ЗначениеЗаполнено(Параметры.Организация)
		Или Не ЗначениеЗаполнено(Параметры.Контрагент) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите организацию и контрагента.'");
	КонецЕсли;
	Если Параметры.Количество < 1 Или Параметры.Количество > 10000
		Или Параметры.Количество <> Цел(Параметры.Количество)
		Или Параметры.НомерЦепочки < 1 Или Параметры.НомерЦепочки > Параметры.Количество
		Или Параметры.НомерЦепочки <> Цел(Параметры.НомерЦепочки) Тогда
		ВызватьИсключение НСтр("ru = 'Количество корректировок должно быть целым числом от 1 до 10000.'");
	КонецЕсли;
	Если ТипЗнч(Параметры.ИдентификаторЗапуска) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный идентификатор запуска.'");
	КонецЕсли;
	Для Каждого ИмяДокумента Из СтрРазделить(
		"РеализацияТоваровУслуг,КорректировкаРеализации,СчетФактураВыданный", ",") Цикл
		ОписаниеДокумента = Метаданные.Документы[ИмяДокумента];
		Если Не ПравоДоступа("Добавление", ОписаниеДокумента)
			Или Не ПравоДоступа("Изменение", ОписаниеДокумента)
			Или Не ПравоДоступа("Проведение", ОписаниеДокумента) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Недостаточно прав на создание и проведение: %1.'"),
				ОписаниеДокумента.Синоним);
		КонецЕсли;
	КонецЦикла;
	Если Не ПраваПользователяПовтИсп.СозданиеРеализацииТоваровУслугБезЗаказа() Тогда
		ВызватьИсключение НСтр("ru = 'Требуется право создания реализации без заказа.'");
	КонецЕсли;
	Если Не ПравоДоступа("Изменение", Метаданные.Константы.КонтролироватьОстаткиТоваровОрганизаций) Тогда
		ВызватьИсключение НСтр("ru = 'Требуется право временного изменения контроля остатков товаров организаций.'");
	КонецЕсли;

КонецПроцедуры

Процедура ЗаблокироватьНастройкуКонтроля()

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Константа.КонтролироватьОстаткиТоваровОрганизаций");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьСтороны(Параметры)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.Организации");
	Элемент.УстановитьЗначение("Ссылка", Параметры.Организация);
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент = Блокировка.Добавить("Справочник.Контрагенты");
	Элемент.УстановитьЗначение("Ссылка", Параметры.Контрагент);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ПроверитьСсылку(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена обязательная ссылка.'");
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	ОбъектПроверки = Ссылка.ПолучитьОбъект();
	Если ОбъектПроверки = Неопределено Или ОбъектПроверки.ПометкаУдаления Тогда
		ВызватьИсключение НСтр("ru = 'Обязательный элемент отсутствует или помечен на удаление.'");
	КонецЕсли;
	Если Не ОбъектПроверки.ПроверитьЗаполнение() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Заполните обязательные реквизиты элемента: %1.'"), Ссылка);
	КонецЕсли;

КонецПроцедуры

// Поиск по имени не является уникальным ключом блокировки каталога.
// При отсутствии элемента блокируем каталог и повторяем поиск; при наличии
// удерживаем только ссылку. Широкая блокировка нужна лишь при первичном создании.
Функция НайтиТестовыйЭлемент(Менеджер, Наименование)

	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Менеджер.ПустаяСсылка().Метаданные().ПолноеИмя());
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Элемент.УстановитьЗначение("Ссылка", Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Иначе
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЕсли;
	Блокировка.Заблокировать();
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование") <> Наименование Тогда
			ВызватьИсключение НСтр("ru = 'Тестовый элемент изменен другим сеансом. Повторите операцию.'");
		КонецЕсли;
	Иначе
		Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Процедура ЗаписатьПроверенныйЭлемент(Элемент)

	Если Не Элемент.ПроверитьЗаполнение() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не заполнены обязательные реквизиты тестового элемента: %1.'"),
			Элемент.Наименование);
	КонецЕсли;
	Элемент.Записать();

КонецПроцедуры

Процедура ПровестиПроверенныйДокумент(Документ)

	Если Не Документ.ПроверитьЗаполнение() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не пройдена проверка заполнения: %1. Цепочка отменена.'"),
			Документ.Метаданные().Синоним);
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Если Не Документ.Проведен Тогда
		ВызватьИсключение НСтр("ru = 'Документ не проведен. Цепочка отменена.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПодготовкаДанных

Функция ПодготовитьДанные(Параметры, ДатаДокументов)

	ПроверитьСсылку(Параметры.Организация);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Контрагент, "ПометкаУдаления") Тогда
		ВызватьИсключение НСтр("ru = 'Контрагент помечен на удаление.'");
	КонецЕсли;
	Если Параметры.Организация = Справочники.Организации.УправленческаяОрганизация Тогда
		ВызватьИсключение НСтр("ru = 'Выбрана управленческая организация. Для цепочки со счетами-фактурами выберите обычную организацию. Ограничений по проценту НДС нет.'");
	КонецЕсли;
	ПараметрыУчетаНДСОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Параметры.Организация, ДатаДокументов);
	НалогообложениеПродажи = ПараметрыУчетаНДСОрганизации.ОсновноеНалогообложениеНДСПродажи;
	Если Не ЗначениеЗаполнено(НалогообложениеПродажи) Тогда
		ВызватьИсключение НСтр("ru = 'Для организации не определено налогообложение продаж на дату документов.'");
	КонецЕсли;
	Валюта = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Параметры.Организация);
	ПроверитьСсылку(Валюта);
	Данные = Новый Структура;
	Данные.Вставить("Валюта", Валюта);
	Данные.Вставить("НалогообложениеНДС", НалогообложениеПродажи);
	Данные.Вставить("Партнер", ПолучитьПартнера(Параметры.Контрагент));
	ПроверитьСсылку(Параметры.Контрагент);
	Данные.Вставить("СтавкаНДС", ПолучитьСтавкуНДС(
		Параметры.Организация, ДатаДокументов, НалогообложениеПродажи));
	Данные.Вставить("Подразделение", ПолучитьПодразделение());
	Данные.Вставить("Склад", ПолучитьТестовыйСклад(Данные.Подразделение));
	Данные.Вставить("Номенклатура", ПолучитьТестовыйТовар(Данные.СтавкаНДС));
	// Штатный подбор учитывает номенклатуру, налогообложение и ставку организации при УСН.
	Данные.СтавкаНДС = УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(
		Данные.Номенклатура, НалогообложениеПродажи, Параметры.Организация,
		ДатаДокументов, Данные.СтавкаНДС, Истина);
	ПроверитьСтавкуНДС(Данные.СтавкаНДС, Параметры.Организация, ДатаДокументов, НалогообложениеПродажи);
	Данные.Вставить("Соглашение", ПолучитьТестовоеСоглашение(Параметры, Данные, ДатаДокументов));
	Возврат Данные;

КонецФункции

Функция ПолучитьПартнера(Контрагент)

	Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентОбъект.Заблокировать();
		ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
		ПартнерОбъект.Заполнить(Неопределено);
		ПартнерОбъект.Наименование = НСтр("ru = 'УКД тестовый клиент'");
		ПартнерОбъект.НаименованиеПолное = ПартнерОбъект.Наименование;
		ПартнерОбъект.Клиент = Истина;
		Если Справочники.ГруппыДоступаПартнеров.ИспользуютсяГруппыДоступа() Тогда
			ПартнерОбъект.ГруппаДоступа = ПолучитьТестовуюГруппуДоступа(Справочники.ГруппыДоступаПартнеров);
		КонецЕсли;
		ЗаписатьПроверенныйЭлемент(ПартнерОбъект);
		Партнер = ПартнерОбъект.Ссылка;
		КонтрагентОбъект.Партнер = Партнер;
		ЗаписатьПроверенныйЭлемент(КонтрагентОбъект);
	КонецЕсли;
	ПроверитьСсылку(Партнер);
	Возврат Партнер;

КонецФункции

Функция ПолучитьТестовуюГруппуДоступа(Менеджер)

	Наименование = НСтр("ru = 'УКД тестовая группа'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	Группа = НайтиТестовыйЭлемент(Менеджер, Наименование);
	Если ЗначениеЗаполнено(Группа) Тогда
		ПроверитьСсылку(Группа);
		Возврат Группа;
	КонецЕсли;
	ОбъектГруппы = Менеджер.СоздатьЭлемент();
	ОбъектГруппы.Заполнить(Неопределено);
	ОбъектГруппы.Наименование = Наименование;
	ЗаписатьПроверенныйЭлемент(ОбъектГруппы);
	Возврат ОбъектГруппы.Ссылка;

КонецФункции

Функция ПолучитьСтавкуНДС(Организация, ДатаДокументов, НалогообложениеПродажи)

	Если НалогообложениеПродажи = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС Тогда
		Ставка = Справочники.СтавкиНДС.БезНДС;
	Иначе
		Ставка = УчетНДСУП.СтавкаНДСПоУмолчанию(Организация, ДатаДокументов, Ложь, НалогообложениеПродажи);
	КонецЕсли;
	Если ЗначениеЗаполнено(Ставка) Тогда
		ПроверитьСтавкуНДС(Ставка, Организация, ДатаДокументов, НалогообложениеПродажи);
		Возврат Ставка;
	КонецЕсли;
	// Если основная ставка не задана, выбираем существующую допустимую ставку.
	// Ставки и учетную политику организации автоматически не изменяем.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Ставки.Ссылка КАК Ссылка
		|ИЗ Справочник.СтавкиНДС КАК Ставки
		|ГДЕ НЕ Ставки.ПометкаУдаления И НЕ Ставки.РасчетнаяСтавка
		|УПОРЯДОЧИТЬ ПО Ставки.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если УчетНДСУП.СтавкаНДСКорректна(Выборка.Ссылка, НалогообложениеПродажи, Организация, ДатаДокументов) Тогда
			ПроверитьСтавкуНДС(Выборка.Ссылка, Организация, ДатаДокументов, НалогообложениеПродажи);
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение НСтр("ru = 'Не найдена ставка НДС, допустимая для организации, даты и налогообложения продажи. Проверьте настройки НДС базы.'");

КонецФункции

Процедура ПроверитьСтавкуНДС(Ставка, Организация, ДатаДокументов, НалогообложениеПродажи)

	ПроверитьСсылку(Ставка);
	Если Не УчетНДСУП.СтавкаНДСКорректна(Ставка, НалогообложениеПродажи, Организация, ДатаДокументов) Тогда
		ВызватьИсключение НСтр("ru = 'Ставка НДС не соответствует организации, дате или налогообложению продажи.'");
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПодразделение()

	Элемент = НайтиТестовыйЭлемент(Справочники.СтруктураПредприятия, "УКД тестовое подразделение");
	Если ЗначениеЗаполнено(Элемент) Тогда
		ПроверитьСсылку(Элемент);
		Возврат Элемент;
	КонецЕсли;
	ОбъектПодразделения = Справочники.СтруктураПредприятия.СоздатьЭлемент();
	ОбъектПодразделения.Заполнить(Неопределено);
	ОбъектПодразделения.Наименование = "УКД тестовое подразделение";
	ОбъектПодразделения.Статус = Перечисления.СтатусыОрганизацийПодразделений.Действует;
	ОбъектПодразделения.ВариантОбособленногоУчетаТоваров = Перечисления.ВариантыОбособленногоУчетаТоваров.НеВедется;
	ЗаписатьПроверенныйЭлемент(ОбъектПодразделения);
	Возврат ОбъектПодразделения.Ссылка;

КонецФункции

Функция ПолучитьТестовыйСклад(Подразделение)

	Склад = НайтиТестовыйЭлемент(Справочники.Склады, "УКД тестовый склад");
	Если ЗначениеЗаполнено(Склад) Тогда
		ПроверитьСсылку(Склад);
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Склад,
			"Подразделение,ТипСклада,КонтролироватьОперативныеОстатки,КонтролироватьСвободныеОстатки,"
			+ "ИспользоватьОрдернуюСхемуПриОтгрузке,ИспользоватьАдресноеХранение,ИспользоватьСкладскиеПомещения");
		Если Реквизиты.Подразделение <> Подразделение
			Или Реквизиты.ТипСклада <> Перечисления.ТипыСкладов.ОптовыйСклад
			Или Реквизиты.КонтролироватьОперативныеОстатки Или Реквизиты.КонтролироватьСвободныеОстатки
			Или Реквизиты.ИспользоватьОрдернуюСхемуПриОтгрузке Или Реквизиты.ИспользоватьАдресноеХранение
			Или Реквизиты.ИспользоватьСкладскиеПомещения Тогда
			ВызватьИсключение НСтр("ru = 'Настройки склада «УКД тестовый склад» изменены и не подходят для тестового проведения.'");
		КонецЕсли;
		Возврат Склад;
	КонецЕсли;
	СкладОбъект = Справочники.Склады.СоздатьЭлемент();
	СкладОбъект.Заполнить(Новый Структура("ТипСклада", Перечисления.ТипыСкладов.ОптовыйСклад));
	СкладОбъект.Наименование = "УКД тестовый склад";
	СкладОбъект.Подразделение = Подразделение;
	СкладОбъект.КонтролироватьОперативныеОстатки = Ложь;
	СкладОбъект.КонтролироватьСвободныеОстатки = Ложь;
	СкладОбъект.ИспользоватьОрдернуюСхемуПриОтгрузке = Ложь;
	СкладОбъект.ИспользоватьОрдернуюСхемуПриПоступлении = Ложь;
	СкладОбъект.ИсточникИнформацииОЦенахДляПечати = Перечисления.ИсточникиИнформацииОЦенахДляПечати.ПоСебестоимости;
	ЗаписатьПроверенныйЭлемент(СкладОбъект);
	Возврат СкладОбъект.Ссылка;

КонецФункции

Функция ПолучитьТестовыйТовар(СтавкаНДС)

	НаименованиеТовара = "УКД тестовый товар " + Строка(СтавкаНДС.УникальныйИдентификатор());
	Товар = НайтиТестовыйЭлемент(Справочники.Номенклатура, НаименованиеТовара);
	Если ЗначениеЗаполнено(Товар) Тогда
		ПроверитьСсылку(Товар);
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Товар,
			"ТипНоменклатуры,ИспользованиеХарактеристик,ВидНоменклатуры.ИспользоватьСерии,"
			+ "АлкогольнаяПродукция,ПродукцияМаркируемаяДляГИСМ,ПодконтрольнаяПродукцияВЕТИС,СтавкаНДС");
		Если Реквизиты.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар
			Или Реквизиты.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать
			Или Реквизиты.ВидНоменклатурыИспользоватьСерии Или Реквизиты.АлкогольнаяПродукция
			Или Реквизиты.ПродукцияМаркируемаяДляГИСМ Или Реквизиты.ПодконтрольнаяПродукцияВЕТИС
			Или Реквизиты.СтавкаНДС <> СтавкаНДС Тогда
			ВызватьИсключение НСтр("ru = 'Настройки тестового товара изменены. Нужен обычный товар без серий и маркировки с выбранной ставкой НДС.'");
		КонецЕсли;
		Возврат Товар;
	КонецЕсли;
	Единица = ПолучитьЕдиницуИзмерения();
	Вид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	Вид.Заполнить(Неопределено);
	Вид.Наименование = "УКД тестовые товары";
	Вид.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	Вид.ИспользоватьХарактеристики = Ложь;
	Вид.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	Вид.ИспользоватьСерии = Ложь;
	Вид.СтавкаНДС = СтавкаНДС;
	Вид.ЕдиницаИзмерения = Единица;
	Вид.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	Если Справочники.ГруппыДоступаНоменклатуры.ИспользуютсяГруппыДоступа() Тогда
		Вид.ГруппаДоступа = ПолучитьТестовуюГруппуДоступа(Справочники.ГруппыДоступаНоменклатуры);
	КонецЕсли;
	Справочники.ВидыНоменклатуры.ОтработатьЛогикуСвязиРеквизитов(Вид);
	ЗаписатьПроверенныйЭлемент(Вид);
	ТоварОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	ТоварОбъект.ВидНоменклатуры = Вид.Ссылка;
	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(ТоварОбъект);
	ТоварОбъект.Наименование = НаименованиеТовара;
	ТоварОбъект.НаименованиеПолное = ТоварОбъект.Наименование;
	ТоварОбъект.ЕдиницаИзмерения = Единица;
	ТоварОбъект.Качество = Перечисления.ГрадацииКачества.Новый;
	ТоварОбъект.СтавкаНДС = СтавкаНДС;
	ТоварОбъект.ГруппаДоступа = Вид.ГруппаДоступа;
	ЗаписатьПроверенныйЭлемент(ТоварОбъект);
	Возврат ТоварОбъект.Ссылка;

КонецФункции

Функция ПолучитьЕдиницуИзмерения()

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.УпаковкиЕдиницыИзмерения");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Единицы.Ссылка КАК Ссылка
		|ИЗ Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
		|ГДЕ НЕ Единицы.ПометкаУдаления
		| И Единицы.Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
		| И Единицы.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
		|УПОРЯДОЧИТЬ ПО Единицы.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПроверитьСсылку(Выборка.Ссылка);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Единица = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Единица.Заполнить(Неопределено);
	Единица.Наименование = "шт";
	Единица.НаименованиеПолное = НСтр("ru = 'Штука'");
	Единица.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	Единица.Числитель = 1;
	Единица.Знаменатель = 1;
	ЗаписатьПроверенныйЭлемент(Единица);
	Возврат Единица.Ссылка;

КонецФункции

Функция ПолучитьТестовоеСоглашение(Параметры, Данные, ДатаДокументов)

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами") Тогда
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
	Наименование = "УКД " + Строка(Параметры.ИдентификаторЗапуска);
	НомерСоглашения = "УКД" + Лев(СтрЗаменить(Строка(Параметры.ИдентификаторЗапуска), "-", ""), 8);
	Соглашение = НайтиТестовыйЭлемент(Справочники.СоглашенияСКлиентами, Наименование);
	Если ЗначениеЗаполнено(Соглашение) Тогда
		ПроверитьСсылку(Соглашение);
		Условия = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Соглашение,
			"Номер,Организация,Партнер,Контрагент,Типовое,Валюта,ВалютаВзаиморасчетов,"
			+ "Склад,ХозяйственнаяОперация,ПорядокРасчетов,ИспользуютсяДоговорыКонтрагентов,ЦенаВключаетНДС,Статус");
		Если Не ЗначениеЗаполнено(Условия.Номер) Тогда
			// Дозаполняем соглашения, созданные предыдущей версией обработки.
			СоглашениеОбъект = Соглашение.ПолучитьОбъект();
			СоглашениеОбъект.Номер = НомерСоглашения;
			ЗаписатьПроверенныйЭлемент(СоглашениеОбъект);
			Условия.Номер = НомерСоглашения;
		КонецЕсли;
		Если Условия.Организация <> Параметры.Организация
			Или Условия.Номер <> НомерСоглашения
			Или Условия.Валюта <> Данные.Валюта Или Условия.ВалютаВзаиморасчетов <> Данные.Валюта
			Или Условия.Склад <> Данные.Склад Или Не Условия.ЦенаВключаетНДС
			Или Условия.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.РеализацияКлиенту
			Или Условия.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоНакладным
			Или Условия.ИспользуютсяДоговорыКонтрагентов
			Или Условия.Статус <> Перечисления.СтатусыСоглашенийСКлиентами.Действует
			Или (Не Условия.Типовое И (Условия.Партнер <> Данные.Партнер
				Или Условия.Контрагент <> Параметры.Контрагент)) Тогда
			ВызватьИсключение НСтр("ru = 'Условия тестового соглашения изменены. Создание документов остановлено.'");
		КонецЕсли;
		Возврат Соглашение;
	КонецЕсли;
	СоглашениеОбъект = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
	СоглашениеОбъект.Заполнить(Неопределено);
	СоглашениеОбъект.Наименование = Наименование;
	СоглашениеОбъект.Номер = НомерСоглашения;
	СоглашениеОбъект.Дата = НачалоДня(ДатаДокументов);
	СоглашениеОбъект.ДатаНачалаДействия = НачалоДня(ДатаДокументов);
	СоглашениеОбъект.Типовое = ПолучитьФункциональнуюОпцию("ИспользоватьТиповыеСоглашенияСКлиентами");
	Если Не СоглашениеОбъект.Типовое Тогда
		СоглашениеОбъект.Партнер = Данные.Партнер;
		СоглашениеОбъект.Контрагент = Параметры.Контрагент;
	КонецЕсли;
	СоглашениеОбъект.Организация = Параметры.Организация;
	СоглашениеОбъект.Валюта = Данные.Валюта;
	СоглашениеОбъект.ВалютаВзаиморасчетов = Данные.Валюта;
	СоглашениеОбъект.ЦенаВключаетНДС = Истина;
	СоглашениеОбъект.Склад = Данные.Склад;
	СоглашениеОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	СоглашениеОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным;
	СоглашениеОбъект.ИспользуютсяДоговорыКонтрагентов = Ложь;
	СоглашениеОбъект.Статус = Перечисления.СтатусыСоглашенийСКлиентами.Действует;
	СоглашениеОбъект.ВариантРасчетаЦен = Перечисления.ВариантыРасчетаЦенПоСоглашениямСКлиентами.УточненныеЦеныПоНоменклатуре;
	Цена = СоглашениеОбъект.Товары.Добавить();
	Цена.Номенклатура = Данные.Номенклатура;
	Цена.Цена = 100;
	ЗаписатьПроверенныйЭлемент(СоглашениеОбъект);
	Возврат СоглашениеОбъект.Ссылка;

КонецФункции

#КонецОбласти

#Область СозданиеДокументов

Функция ЗаписатьЦепочку(Параметры, Данные, ДатаДокументов, Маркер)

	Реализация = ЗаполнитьРеализацию(Параметры, Данные, ДатаДокументов, Маркер);
	ПровестиПроверенныйДокумент(Реализация);
	ИсходныйСчетФактура = СоздатьСчетФактуру(Реализация.Ссылка, ДатаДокументов, Маркер);
	Корректировка = ЗаполнитьКорректировку(Реализация, ДатаДокументов, Маркер);
	ПровестиПроверенныйДокумент(Корректировка);
	СчетФактура = СоздатьСчетФактуру(Корректировка.Ссылка, ДатаДокументов, Маркер);
	Результат = Новый Структура;
	Результат.Вставить("Реализация", Реализация.Ссылка);
	Результат.Вставить("ИсходныйСчетФактура", ИсходныйСчетФактура);
	Результат.Вставить("Корректировка", Корректировка.Ссылка);
	Результат.Вставить("СчетФактура", СчетФактура);
	Возврат Результат;

КонецФункции

Функция ЗаполнитьРеализацию(Параметры, Данные, ДатаДокументов, Маркер)

	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура("Организация,Контрагент,Партнер,Склад,Соглашение",
		Параметры.Организация, Параметры.Контрагент, Данные.Партнер, Данные.Склад, Данные.Соглашение);
	ДанныеЗаполнения.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	Документ.Дата = ДатаДокументов;
	Документ.Заполнить(ДанныеЗаполнения);
	Документ.Организация = Параметры.Организация;
	Документ.Контрагент = Параметры.Контрагент;
	Документ.Партнер = Данные.Партнер;
	Документ.Соглашение = Данные.Соглашение;
	Если ЗначениеЗаполнено(Данные.Соглашение) Тогда
		Документ.ЗаполнитьУсловияПродажПоСоглашению();
	КонецЕсли;
	Документ.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Документ.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным;
	Документ.Валюта = Данные.Валюта;
	Документ.ВалютаВзаиморасчетов = Данные.Валюта;
	Документ.Склад = Данные.Склад;
	Документ.Подразделение = Данные.Подразделение;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Документ.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	Документ.РеализацияПоЗаказам = Ложь;
	Документ.ЦенаВключаетНДС = Истина;
	Документ.НалогообложениеНДС = Данные.НалогообложениеНДС;
	Документ.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	Документ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	Документ.Менеджер = Пользователи.ТекущийПользователь();
	Документ.Комментарий = Маркер;
	Документ.Товары.Очистить();
	СтрокаТоваров = Документ.Товары.Добавить();
	СтрокаТоваров.Номенклатура = Данные.Номенклатура;
	СтрокаТоваров.Склад = Данные.Склад;
	СтрокаТоваров.Подразделение = Данные.Подразделение;
	СтрокаТоваров.СтавкаНДС = Данные.СтавкаНДС;
	СтрокаТоваров.КодСтроки = 1;
	СтрокаТоваров.КлючСвязи = 1;
	// Детерминированная последовательность 1..10 упрощает воспроизводимость теста.
	СтрокаТоваров.Количество = (Параметры.НомерЦепочки - 1) % 10 + 1;
	СтрокаТоваров.КоличествоУпаковок = СтрокаТоваров.Количество;
	СтрокаТоваров.Цена = 100;
	ПересчитатьСтроку(СтрокаТоваров, Документ.НалогообложениеНДС);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиВПродажах") Тогда
		ПараметрыСкидок = СкидкиНаценкиЗаполнениеСервер.НовыйПараметрыРассчитать();
		РезультатСкидок = СкидкиНаценкиЗаполнениеСервер.Рассчитать(Документ, ПараметрыСкидок);
		СкидкиНаценкиЗаполнениеСервер.ПрименитьРезультатРасчета(Документ, РезультатСкидок);
	КонецЕсли;
	Документ.СкидкиРассчитаны = Истина;
	Документ.СуммаДокумента = Документ.Товары.Итог("СуммаСНДС");
	Возврат Документ;

КонецФункции

Функция ЗаполнитьКорректировку(Реализация, ДатаДокументов, Маркер)

	Документ = Документы.КорректировкаРеализации.СоздатьДокумент();
	Документ.Дата = ДатаДокументов;
	Документ.Заполнить(Реализация.Ссылка);
	Документ.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
	Документ.Комментарий = Маркер;
	Если Документ.Товары.Количество() <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'Штатное заполнение корректировки не вернуло одну строку товара.'");
	КонецЕсли;
	СтрокаТоваров = Документ.Товары[0];
	ИсходнаяСтрока = Реализация.Товары[0];
	СтрокаТоваров.Количество = ?(ИсходнаяСтрока.Количество < 10, ИсходнаяСтрока.Количество + 1, 9);
	СтрокаТоваров.КоличествоУпаковок = СтрокаТоваров.Количество;
	// Сохраняем фактическую цену после штатно рассчитанных скидок реализации.
	СтрокаТоваров.Цена = ИсходнаяСтрока.СуммаСНДС / ИсходнаяСтрока.Количество;
	ПересчитатьСтроку(СтрокаТоваров, Документ.НалогообложениеНДС);
	Документ.ЗаполнитьРасхождения();
	Если Документ.Расхождения.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не сформированы расхождения по количеству.'");
	КонецЕсли;
	// Штатный расчет расхождений оставляет выбор отражения количества товара форме.
	// Повторяем ее выбор с учетом ордерной схемы склада по излишкам и недостачам.
	Для Каждого СтрокаРасхождений Из Документ.Расхождения Цикл
		СкладРасхождения = СтрокаРасхождений.Склад;
		Если Не ЗначениеЗаполнено(СкладРасхождения) Тогда
			СкладРасхождения = Документ.Склад;
		КонецЕсли;
		ОрдерноеОтражениеРасхождений = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СкладРасхождения, "ИспользоватьОрдернуюСхемуПриОтраженииИзлишковНедостач");
		Если СтрокаРасхождений.Количество > 0 Тогда
			СтрокаРасхождений.ВариантОтражения = ?(ОрдерноеОтражениеРасхождений,
				Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУчестьПриИнвентаризации,
				Перечисления.ВариантыОтраженияКорректировокРеализаций.УвеличитьРеализациюУменьшитьСкладскиеОстатки);
		ИначеЕсли СтрокаРасхождений.Количество < 0 Тогда
			СтрокаРасхождений.ВариантОтражения = ?(ОрдерноеОтражениеРасхождений,
				Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУчестьПриИнвентаризации,
				Перечисления.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУвеличитьСкладскиеОстатки);
		КонецЕсли;
	КонецЦикла;
	Документ.СуммаДокумента = Документ.Товары.Итог("СуммаСНДС");
	Возврат Документ;

КонецФункции

Процедура ПересчитатьСтроку(СтрокаТоваров, НалогообложениеПродажи)

	СтрокаТоваров.Сумма = Окр(СтрокаТоваров.Цена * СтрокаТоваров.КоличествоУпаковок, 2);
	СтрокаТоваров.СуммаСНДС = СтрокаТоваров.Сумма;
	СтрокаТоваров.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
		СтрокаТоваров.СуммаСНДС, СтрокаТоваров.СтавкаНДС, Истина, НалогообложениеПродажи);
	СтрокаТоваров.СуммаВзаиморасчетов = СтрокаТоваров.СуммаСНДС;

КонецПроцедуры

Функция СоздатьСчетФактуру(Основание, ДатаДокументов, Маркер)

	Документ = Документы.СчетФактураВыданный.СоздатьДокумент();
	Документ.Дата = ДатаДокументов;
	Документ.Заполнить(Основание);
	// Основания хранятся в отдельной табличной части. Штатный метод формы
	// согласует с ней реквизиты шапки и заполняет товары для корректировочного СФ.
	Документ.ЗаполнитьПараметрыСчетаФактурыПоОснованию();
	Документ.Дата = ДатаДокументов;
	Документ.ДатаВыставления = ДатаДокументов;
	Документ.Комментарий = Маркер;
	Если Документ.ДокументОснование <> Основание Или Документ.ДокументыОснования.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Счет-фактура: не заполнено единственное основание %1.'"), Основание);
	КонецЕсли;
	Если Документ.ДокументыОснования[0].ДокументОснование <> Основание Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Счет-фактура: основание в таблице не соответствует документу %1.'"), Основание);
	КонецЕсли;
	ОжидаетсяКорректировочный = ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаРеализации");
	Если Документ.Корректировочный <> ОжидаетсяКорректировочный Или Документ.Исправление Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Счет-фактура: вид документа не соответствует основанию %1.'"), Основание);
	КонецЕсли;
	// Для обычного СФ по реализации пустые Товары являются штатным результатом:
	// см. Документы.СчетФактураВыданный.ТаблицаТоваров.
	Если ОжидаетсяКорректировочный И Документ.Товары.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Корректировочный счет-фактура: не заполнены товары по основанию %1.'"), Основание);
	КонецЕсли;
	ПровестиПроверенныйДокумент(Документ);
	Возврат Документ.Ссылка;

КонецФункции

#КонецОбласти

#Область ПовторныйЗапуск

Функция НайтиСозданнуюЦепочку(Маркер, Параметры)

	// Комментарий имеет неограниченную длину: сравнение через = в запросе запрещено.
	// Маркер состоит из фиксированного префикса, UUID и номера без символов шаблона.
	// ПОДОБНО без % и _ сравнивает весь маркер, не обрезая длинные комментарии.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Реализация.Ссылка КАК Реализация,
		| ИсходныйСФ.Ссылка КАК ИсходныйСчетФактура,
		| Корректировка.Ссылка КАК Корректировка,
		| СчетФактура.Ссылка КАК СчетФактура
		|ИЗ Документ.РеализацияТоваровУслуг КАК Реализация
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Корректировка
		| ПО Корректировка.ДокументОснование = Реализация.Ссылка И Корректировка.Комментарий ПОДОБНО &Маркер
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК ИсходныйСФ
		| ПО ИсходныйСФ.ДокументОснование = Реализация.Ссылка И ИсходныйСФ.Комментарий ПОДОБНО &Маркер
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактура
		| ПО СчетФактура.ДокументОснование = Корректировка.Ссылка И СчетФактура.Комментарий ПОДОБНО &Маркер
		|ГДЕ Реализация.Комментарий ПОДОБНО &Маркер";
	Запрос.УстановитьПараметр("Маркер", Маркер);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Таблица.Количество() <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'Обнаружены дубли тестовой цепочки. Требуется проверка документов.'");
	КонецЕсли;
	Результат = Новый Структура("Реализация,ИсходныйСчетФактура,Корректировка,СчетФактура");
	ЗаполнитьЗначенияСвойств(Результат, Таблица[0]);
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Пара Из Результат Цикл
		Если Не ЗначениеЗаполнено(Пара.Значение) Тогда
			ВызватьИсключение НСтр("ru = 'Ранее созданная цепочка изменена: не все документы найдены.'");
		КонецЕсли;
		Элемент = Блокировка.Добавить(Пара.Значение.Метаданные().ПолноеИмя());
		Элемент.УстановитьЗначение("Ссылка", Пара.Значение);
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	КонецЦикла;
	Блокировка.Заблокировать();
	// Повторное ответственное чтение оснований и маркеров после получения блокировок.
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'Цепочка изменена другим сеансом. Требуется проверка документов.'");
	КонецЕсли;
	Для Каждого Пара Из Результат Цикл
		Если Пара.Значение <> Таблица[0][Пара.Ключ] Тогда
			ВызватьИсключение НСтр("ru = 'Основания цепочки изменены другим сеансом.'");
		КонецЕсли;
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пара.Значение,
			"Проведен,ПометкаУдаления,Организация,Контрагент");
		Если Не Реквизиты.Проведен Или Реквизиты.ПометкаУдаления
			Или Реквизиты.Организация <> Параметры.Организация
			Или Реквизиты.Контрагент <> Параметры.Контрагент Тогда
			ВызватьИсключение НСтр("ru = 'Ранее созданная цепочка изменена. Автоматическое повторное создание остановлено.'");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли

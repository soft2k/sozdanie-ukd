#Область ОписаниеПеременных

&НаКлиенте
Перем ВыполнениеАктивно; // Булево - запущено фоновое задание серии.

&НаКлиенте
Перем ИдентификаторФоновогоЗадания; // УникальныйИдентификатор - нужен для явной остановки.

&НаКлиенте
Перем ОтменаЗапрошена; // Булево - пользователь нажал "Остановить".

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Количество = 1;
	НомерЦепочки = 1;
	СсылкаОбработки = Неопределено;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки)
		И ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Состояние = НСтр("ru = 'Будут проведены тестовые документы. Создание выполняется в фоне; используйте тестовую базу.'");
	Иначе
		Состояние = НСтр("ru = 'Для фонового запуска зарегистрируйте EPF в списке дополнительных отчетов и обработок и откройте ее оттуда.'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Открывать другую форму непосредственно из ПриОткрытии не следует:
	// короткое ожидание дает основной форме завершить отображение окна.
	ПодключитьОбработчикОжидания("ОткрытьИнструкцию", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИнструкцию()

	ОткрытьФорму("ВнешняяОбработка.СозданиеУКД.Форма.Инструкция", , ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	// Форма не является владельцем ожидания, поэтому ее закрытие
	// не отменяет уже запущенное фоновое задание.

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультаты

&НаКлиенте
Процедура РезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаРезультата = Результаты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаРезультата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.РезультатыРеализация Тогда
		СсылкаДокумента = СтрокаРезультата.Реализация;
		ИмяФормыДокумента = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
	ИначеЕсли Поле = Элементы.РезультатыКорректировка Тогда
		СсылкаДокумента = СтрокаРезультата.Корректировка;
		ИмяФормыДокумента = "Документ.КорректировкаРеализации.ФормаОбъекта";
	ИначеЕсли Поле = Элементы.РезультатыИсходныйСчетФактура Тогда
		СсылкаДокумента = СтрокаРезультата.ИсходныйСчетФактура;
		ИмяФормыДокумента = "Документ.СчетФактураВыданный.ФормаОбъекта";
	ИначеЕсли Поле = Элементы.РезультатыСчетФактура Тогда
		СсылкаДокумента = СтрокаРезультата.СчетФактура;
		ИмяФормыДокумента = "Документ.СчетФактураВыданный.ФормаОбъекта";
	Иначе
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
		ОткрытьФорму(ИмяФормыДокумента, Новый Структура("Ключ", СсылкаДокумента));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Создать(Команда)

	Если ВыполнениеАктивно = Истина Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Контрагент)
		Или Количество < 1 Или Количество > 10000 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выберите организацию, контрагента и количество корректировок от 1 до 10000.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если Не ОбработкаЗарегистрирована() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Фоновый режим доступен только для зарегистрированной дополнительной обработки. Добавьте EPF в список дополнительных отчетов и обработок и откройте команду оттуда.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ИдентификаторЗапуска) Тогда
		ИдентификаторЗапуска = Строка(Новый УникальныйИдентификатор);
		НомерЦепочки = 1;
	КонецЕсли;
	Если НомерЦепочки > Количество Тогда
		Состояние = НСтр("ru = 'Серия завершена. Для новой серии нажмите «Новая серия».'");
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеЗадания = ЗапуститьСозданиеВФоне();
	Исключение
		Состояние = СтрШаблон(НСтр("ru = 'Не удалось запустить фоновое задание. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ИдентификаторФоновогоЗадания = ДанныеЗадания.ИдентификаторЗадания;
	ОтменаЗапрошена = Ложь;
	ВыполнениеАктивно = Истина;
	Состояние = СтрШаблон(НСтр("ru = 'Фоновое задание запущено с цепочки %1 из %2. Форму можно закрыть.'"),
		НомерЦепочки, Количество);
	УстановитьДоступностьКоманд();

	ОповещениеОПрогрессе = Новый ОписаниеОповещения("ФоновоеСозданиеПрогресс", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ОповещениеОПрогрессе;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ФоновоеСозданиеЗавершено", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДанныеЗадания,
		ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)

	Если ВыполнениеАктивно <> Истина Или Не ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОтменитьФоновоеЗаданиеНаСервере(ИдентификаторФоновогоЗадания);
		ОтменаЗапрошена = Истина;
		Состояние = НСтр("ru = 'Запрошена остановка. Текущая цепочка будет отменена, завершенные цепочки сохранятся.'");
		Элементы.Остановить.Доступность = Ложь;
	Исключение
		Состояние = СтрШаблон(НСтр("ru = 'Не удалось остановить фоновое задание. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НоваяСерия(Команда)

	Если ВыполнениеАктивно = Истина Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторЗапуска = "";
	НомерЦепочки = 1;
	Результаты.Очистить();
	Состояние = НСтр("ru = 'Новая серия. Ранее созданные документы сохранены в базе.'");
	УстановитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ФоновоеСозданиеПрогресс(ДанныеПрогресса, ДополнительныеПараметры) Экспорт

	Если ДанныеПрогресса.Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Состояние = ДанныеПрогресса.Прогресс.Текст;

КонецПроцедуры

&НаКлиенте
Процедура ФоновоеСозданиеЗавершено(Задание, ДополнительныеПараметры) Экспорт

	ОтменаБылаЗапрошена = ОтменаЗапрошена;
	ВыполнениеАктивно = Ложь;
	ИдентификаторФоновогоЗадания = Неопределено;
	ОтменаЗапрошена = Ложь;
	Попытка
		ОбновитьРезультатыНаСервере();
	Исключение
		Состояние = СтрШаблон(НСтр("ru = 'Задание завершилось, но не удалось прочитать результаты. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УстановитьДоступностьКоманд();
		Возврат;
	КонецПопытки;
	НомерЦепочки = Результаты.Количество() + 1;

	Если Задание.Статус = "Выполнено" Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Готово. Создано корректировок: %1. Документы доступны в таблице.'"),
			Результаты.Количество());
	ИначеЕсли Задание.Статус = "Ошибка" Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Фоновое задание завершилось с ошибкой после %1 цепочек. %2'"),
			Результаты.Количество(), Задание.ПодробноеПредставлениеОшибки);
	ИначеЕсли ОтменаБылаЗапрошена Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Остановлено. Завершено цепочек: %1. Кнопка «Создать» продолжит серию.'"),
			Результаты.Количество());
	Иначе
		Состояние = СтрШаблон(НСтр("ru = 'Фоновое задание остановлено. Завершено цепочек: %1.'"),
			Результаты.Количество());
	КонецЕсли;
	УстановитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Функция ОбработкаЗарегистрирована()

	СсылкаОбработки = Неопределено;
	Возврат Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки)
		И ЗначениеЗаполнено(СсылкаОбработки);

КонецФункции

&НаСервере
Функция ЗапуститьСозданиеВФоне()

	ПараметрыФоновогоЗадания = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыФоновогоЗадания.ОжидатьЗавершение = 0;
	ПараметрыФоновогоЗадания.ЗапуститьВФоне = Истина;
	ПараметрыФоновогоЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Создание реализаций и корректировок'");

	Обработка = РеквизитФормыВЗначение("Объект");
	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("ДополнительнаяОбработкаСсылка", Параметры.ДополнительнаяОбработкаСсылка);
	ПараметрыФункции.Вставить("ИдентификаторКоманды", Обработка.ИдентификаторФоновойКоманды());
	ПараметрыФункции.Вставить("Контекст_Организация", Организация);
	ПараметрыФункции.Вставить("Контекст_Контрагент", Контрагент);
	ПараметрыФункции.Вставить("Контекст_Количество", Количество);
	ПараметрыФункции.Вставить("Контекст_НомерЦепочки", НомерЦепочки);
	ПараметрыФункции.Вставить("Контекст_ИдентификаторЗапуска", ИдентификаторЗапуска);

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыФоновогоЗадания,
		"ДополнительныеОтчетыИОбработки.ВыполнитьКоманду", ПараметрыФункции);

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьФоновоеЗаданиеНаСервере(Знач ИдентификаторЗадания)

	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);

КонецПроцедуры

&НаСервере
Процедура ОбновитьРезультатыНаСервере()

	Если ПустаяСтрока(ИдентификаторЗапуска) Тогда
		Результаты.Очистить();
		Возврат;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	ТаблицаРезультатов = Обработка.ПолучитьРезультатыЗапуска(
		Новый УникальныйИдентификатор(ИдентификаторЗапуска));
	ЗначениеВРеквизитФормы(ТаблицаРезультатов, "Результаты");

КонецПроцедуры

// Оставлена как точка вызова интеграционного теста формы.
&НаСервере
Процедура ПеренестиПредупрежденияОбОстаткахВЖурнал(Знач Результат)

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПеренестиПредупрежденияОбОстаткахВЖурнал(Результат);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоманд()

	Элементы.Создать.Доступность = ВыполнениеАктивно <> Истина;
	Элементы.Остановить.Доступность = ВыполнениеАктивно = Истина И ОтменаЗапрошена <> Истина;
	Элементы.НоваяСерия.Доступность = ВыполнениеАктивно <> Истина;
	МожноМенятьПараметры = ПустаяСтрока(ИдентификаторЗапуска);
	Элементы.Организация.Доступность = МожноМенятьПараметры;
	Элементы.Контрагент.Доступность = МожноМенятьПараметры;
	Элементы.Количество.Доступность = МожноМенятьПараметры;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	HTMLИнструкции = ТекстИнструкции();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьИнструкцию(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ТекстИнструкции()

	ТекстHTML =
	"<html lang='ru'>
	|<head>
	|<meta charset='utf-8'>
	|<style>
	|body { margin: 0; padding: 24px; background: #f4f6f8; color: #263238; font-family: Arial, sans-serif; font-size: 14px; line-height: 1.48; }
	|.card { max-width: 820px; margin: 0 auto; padding: 26px 30px; background: #ffffff; border: 1px solid #dfe4e8; }
	|h1 { margin: 0 0 8px; color: #174a74; font-size: 25px; font-weight: normal; }
	|h2 { margin: 24px 0 8px; color: #174a74; font-size: 17px; }
	|p { margin: 8px 0; }
	|ol, ul { margin: 8px 0 8px 24px; padding: 0; }
	|li { margin: 6px 0; }
	|.warning { margin: 18px 0; padding: 13px 15px; background: #fff4df; border-left: 5px solid #e89b23; color: #593d10; }
	|.note { margin-top: 18px; padding: 12px 15px; background: #edf6fc; border-left: 5px solid #3d8dbd; }
	|.button { padding: 2px 7px; background: #e8edf1; border: 1px solid #b8c2ca; white-space: nowrap; }
	|</style>
	|</head>
	|<body>
	|<div class='card'>
	|<h1>Создание тестовых реализаций и корректировок</h1>
	|<p>Обработка создаёт цепочки из реализации, исходного счёта-фактуры, корректировки реализации и корректировочного счёта-фактуры.</p>
	|<div class='warning'><strong>Важно:</strong> документы записываются и проводятся. Используйте обработку только в отдельной тестовой базе.</div>
	|<h2>Как запустить</h2>
	|<ol>
	|<li>Зарегистрируйте EPF в разделе <strong>Дополнительные отчёты и обработки</strong> и открывайте обработку из этого списка. При открытии через <strong>Файл — Открыть</strong> фоновый запуск недоступен.</li>
	|<li>Выберите организацию, контрагента и количество цепочек.</li>
	|<li>Нажмите <span class='button'>Создать</span>. Задание выполняется в фоне, поэтому основную форму можно закрыть.</li>
	|</ol>
	|<h2>Во время выполнения</h2>
	|<ul>
	|<li><span class='button'>Остановить</span> запрашивает отмену задания. Текущая незавершённая цепочка откатывается, ранее созданные документы остаются.</li>
	|<li><span class='button'>Новая серия</span> создаёт новый идентификатор серии. Документы предыдущей серии не удаляются.</li>
	|<li>В таблице результатов дважды щёлкните документ или нажмите Enter, чтобы открыть его.</li>
	|</ul>
	|<div class='note'>Для выполнения нужны права на создание и проведение документов и справочников. Обработка может создавать тестовые справочные данные и намеренно допускает отрицательные остатки тестового товара.</div>
	|</div>
	|</body>
	|</html>";

	Возврат ТекстHTML;

КонецФункции

#КонецОбласти
